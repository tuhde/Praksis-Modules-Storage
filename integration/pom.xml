<?xml version="1.0" encoding="UTF-8"?>
<!-- SPDX-License-Identifier: Apache-2.0 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>it.uhde</groupId>
    <artifactId>praksis-modules-storage-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <relativePath>../pom.xml</relativePath>
  </parent>

  <artifactId>praksis-modules-storage-integration</artifactId>
  <name>Praksis storage modules: integration tests</name>
  <description>Installs the module archives into a home directory of the runtime image of the core and runs the daemon and the CLI with entities kept in them.</description>

  <dependencies>
    <!-- The wire protocol, for the tests that talk to the daemon. -->
    <dependency>
      <groupId>it.uhde</groupId>
      <artifactId>praksis-protocol</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- Reads the databases that the daemon wrote, in the tests. -->
    <dependency>
      <groupId>org.xerial</groupId>
      <artifactId>sqlite-jdbc</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- A driver that is not the daemon's: its jar goes into the archive of the jdbc module. -->
    <dependency>
      <groupId>com.h2database</groupId>
      <artifactId>h2</artifactId>
      <version>2.3.232</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <!-- sets the property ${com.h2database:h2:jar} to the path of the jar -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>driver-path</id>
            <phase>pre-integration-test</phase>
            <goals>
              <goal>properties</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-failsafe-plugin</artifactId>
        <executions>
          <execution>
            <goals>
              <goal>integration-test</goal>
              <goal>verify</goal>
            </goals>
          </execution>
        </executions>
        <configuration>
          <systemPropertyVariables>
            <!-- the runtime image of the core, built with './mvnw install' there -->
            <praksis.image>${praksis.core}/praksis-dist/target/praksis</praksis.image>
            <!-- the directory with the module directories, whose target directories hold the archives -->
            <praksis.modules>${project.basedir}/..</praksis.modules>
            <!-- the jar of the H2 driver, to put into the archive of the jdbc module -->
            <h2.jar>${com.h2database:h2:jar}</h2.jar>
          </systemPropertyVariables>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <properties>
    <praksis.core>${project.basedir}/../../Praksis</praksis.core>
  </properties>
</project>
